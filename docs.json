{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PlantOPS Documentation",
  "description": "PlantOPS Manufacturing Execution Platform documentation.",
  "settings": {
    "modeToggle": {
      "default": "light",
      "isHidden": true
    }
  },
  "colors": {
    "primary": "#0E3A5F",
    "light": "#1565B0",
    "dark": "#0E3A5F"
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "/"
  },
  "favicon": "/favicon.png",
  "fonts": {
    "family": "Inter"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index"]
          },
          {
            "group": "Admin App",
            "pages": ["employees", "employee-tasks", "employee-task-report"]
          },
          {
            "group": "Documents",
            "pages": ["templates/document-template"]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://plantops.io"
    }
  }
}